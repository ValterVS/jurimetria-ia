# Porta do servidor. Em produção (Render) a plataforma injeta PORT automaticamente.
PORT=3000

# development | production
NODE_ENV=development

# String de conexão do PostgreSQL. Em produção, aponte para o banco na nuvem
# (Neon, Supabase, Railway etc). Nunca commitar o valor real.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/jurimetria

# URL do frontend autorizada pelo CORS.
FRONTEND_URL=http://localhost:5173

# Credenciais da Anthropic (Claude). Usadas SOMENTE pelo backend, nunca pelo frontend.
ANTHROPIC_API_KEY=
# Modelos disponíveis em ago/2026 (verifique docs.claude.com/en/docs/about-claude/models
# para a lista atualizada - modelos e preços mudam com frequência):
#   claude-opus-5   -> maior qualidade de raciocínio, mais caro (~$5/$25 por MTok)
#   claude-sonnet-5 -> equilíbrio custo/qualidade (~$2-3/$10-15 por MTok) - padrão usado no código
#   claude-haiku-4-5-20251001 -> mais barato, indicado para altíssimo volume (~$1/$5 por MTok)
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional. Limite de tokens de saída por análise (inclui o "pensamento"
# interno do modelo, que conta no mesmo orçamento). O padrão no código já é
# 8000; só defina aqui se quiser um valor diferente.
# ANTHROPIC_MAX_TOKENS=8000

# Opcional. Nível de esforço do modelo (low | medium | high | xhigh | max).
# Sonnet 5 usa "high" por padrão na API, mas para uma tarefa de extração/
# classificação como esta, "medium" (padrão no código) já é suficiente e
# reduz custo. Use "low" para cortar custo ainda mais, ao custo de alguma
# qualidade.
# ANTHROPIC_EFFORT=medium

# --- Autenticação (login, cadastro, verificação por e-mail) ---

# Obrigatória. Segredo usado para assinar os tokens JWT de sessão.
# Gere um valor aleatório forte (ex: openssl rand -hex 32) e nunca reutilize
# entre ambientes (dev/produção).
JWT_SECRET=

# Opcional. Validade do token de sessão. Padrão no código: 7d (7 dias).
# JWT_EXPIRES_IN=7d

# Configuração de envio de e-mail (código de verificação de cadastro e link
# de redefinição de senha). Compatível com qualquer provedor SMTP comum
# (Gmail, SendGrid, Amazon SES, Mailtrap para testes, etc). Sem essas
# variáveis configuradas, o cadastro e a redefinição de senha continuam
# funcionando, mas o e-mail não é enviado (erro 503 tratado no backend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# E-mail que aparece como remetente. Se não definido, usa SMTP_USER.
SMTP_FROM=
